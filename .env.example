# Supabase Configuration
# ============================================================
# PizzaStockAI - Variáveis de Ambiente
# ============================================================
#
# ⚠️ IMPORTANTE: Para aplicar migrações e usar funções RPC, você PRECISA
# configurar SUPABASE_SERVICE_ROLE_KEY na Vercel.
#
# Como obter as chaves:
# 1. Acesse https://supabase.com/dashboard
# 2. Selecione seu projeto
# 3. Vá para Settings → API
# 4. Copie os valores abaixo:
#
# SUPABASE_URL:
#   - Campo: Project URL
#   - Exemplo: https://SEU-PROJETO.supabase.co
#
# SUPABASE_PUBLISHABLE_KEY (chave pública/anon):
#   - Campo: API Keys → anon public
#   - Começa com: sb_publishable_
#   - Usada no navegador para leitura do catálogo
#
# SUPABASE_SERVICE_ROLE_KEY (chave secreta - ESSENCIAL):
#   - Campo: API Keys → service_role secret
#   - Começa com: sb_secret_
#   - ⚠️ NUNCA exponha esta chave no frontend ou em repositórios públicos!
#   - Usada apenas no servidor para:
#     * Aplicar migrações de banco de dados
#     * Executar funções RPC (criar pedido, confirmar pagamento, etc.)
#     * Operações administrativas
#
# ============================================================
# Configuração na Vercel:
# 1. Acesse vercel.com → PizzaStockAI → Settings → Environment Variables
# 2. Adicione SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, SUPABASE_PUBLISHABLE_KEY
# 3. Selecione "Production" e "Preview" para cada variável
# 4. Faça um novo deploy para aplicar as variáveis
# ============================================================

SUPABASE_PROJECT_ID="your-project-id"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="sb_secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# Enviare PIX Gateway Configuration
# Get your credentials from: https://enviare.com.br
# These are required for automatic PIX payment processing
ENVIARE_API_KEY="your-enviare-api-key"
ENVIARE_MERCHANT_ID="your-enviare-merchant-id"
ENVIARE_WEBHOOK_SECRET="your-enviare-webhook-secret"
ENVIARE_BASE_URL="https://api.enviare.com.br/v1"
# Supabase Edge Function URL para receber webhooks do Enviare
# Formato: https://<project-ref>.supabase.co/functions/v1/pix-webhook
ENVIARE_WEBHOOK_URL="https://your-project-ref.supabase.co/functions/v1/pix-webhook"
